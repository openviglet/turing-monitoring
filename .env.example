# Copy this file to .env and fill with your credentials
# DO NOT commit the .env file to Git!

# Mailchimp Transactional (Mandrill) API Key
# Get it at: https://mandrillapp.com/settings
MAILCHIMP_API_KEY=your-api-key-here

# Email to receive reports
EMAIL_RECIPIENT=your-email@gmail.com

# Optional settings (overrides config.ini)
# API_BASE_URL=http://localhost:2700/api/sn/sample/search
# SELENIUM_HEADLESS=true
# RETRY_MAX_ATTEMPTS=3
